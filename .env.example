# Azure AI Agent POC — Local Development Environment
# Copy this file to .env and fill in the values.
# ⚠️  NEVER commit .env to source control.

# ── Azure tenant & subscription ──────────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# ── Deployment settings ──────────────────────────────────────────────────────
# ENVIRONMENT_NAME: short name used for tagging and (by default) the RG name.
# RESOURCE_GROUP_NAME: actual resource group name (defaults to rg-{ENVIRONMENT_NAME}).
#   Tip: use a unique name each time — the 8-char resource token is derived from
#   the RG name, so different RG names always produce non-conflicting resource names.
ENVIRONMENT_NAME=agenttest
RESOURCE_GROUP_NAME=rg-agenttest
AZURE_LOCATION=swedencentral

# ── MCP server app registration ──────────────────────────────────────────────
# Created automatically by Container Apps Easy Auth on first deploy.
# Populate AFTER the first Bicep deployment, then run ./setup-obo-auth.sh.
#
# Get App ID:
#   az ad app list --display-name ca-mcp --query '[0].appId' -o tsv
# Get SP Object ID:
#   az ad sp show --id <appId> --query id -o tsv
# Get Mcp.Tools.ReadWrite.All role ID:
#   az ad app show --id <appId> --query "appRoles[?value=='Mcp.Tools.ReadWrite.All'].id" -o tsv
MCP_APP_ID=<mcp-ca-app-registration-client-id>
MCP_APP_SP_OBJECT_ID=<mcp-ca-service-principal-object-id>
MCP_APP_ROLE_ID=<mcp-tools-readwrite-all-app-role-id>

# ── APIM Gateway app registration ────────────────────────────────────────────
# Created automatically by deploy.sh if not set.
# To create manually:
#   az ad app create --display-name "APIM-Gateway-<name>" --sign-in-audience AzureADMyOrg
#   az ad app credential reset --id <appId> --display-name apim-obo-secret --years 2
# IMPORTANT: setup-obo-auth.sh ensures identifierUris and requestedAccessTokenVersion=2
# are configured on this app — these are REQUIRED for Entra to accept token requests.
APIM_GATEWAY_APP_ID=<apim-gateway-app-registration-client-id>
APIM_GATEWAY_SP_OBJECT_ID=<apim-gateway-app-sp-object-id>
APIM_GATEWAY_CLIENT_SECRET=<your-apim-app-client-secret>

# ── APIM publisher ───────────────────────────────────────────────────────────
APIM_PUBLISHER_EMAIL=admin@contoso.com

# ── APIM instance (populated after deployment) ───────────────────────────────
# Automatically set by deploy.sh after a successful deployment.
# Required by setup-obo-auth.sh to sync named values and apply the policy.
# APIM_STANDARD_NAME=apim-<resource-token>
# APIM_GATEWAY_URL=https://apim-<resource-token>.azure-api.net

# ── AI Foundry (populated after deployment) ──────────────────────────────────
# Automatically set by deploy.sh. Used by setup-obo-auth.sh to grant MI roles.
#
# The new-style project (visible in ai.azure.com new UI):
# NEW_FOUNDRY_PROJECT_NAME=agent-project
# NEW_FOUNDRY_PROJECT_ENDPOINT=https://aiss-<token>.services.ai.azure.com/api/projects/agent-project
# FOUNDRY_PROJECT_MI_OBJECT_ID=<new-project-system-mi-object-id>
#
# Optional: old-style project MI (MachineLearningServices/workspaces kind=Project):
# OLD_FOUNDRY_PROJECT_MI_OBJECT_ID=<old-project-system-mi-object-id>

# ── Optional: Service Principal for local dev ────────────────────────────────
# Object ID of an SP to grant the same RBAC roles as the Container App MI.
# Get with: az ad sp show --id <appId> --query id -o tsv
# AZURE_SP_OBJECT_ID=

# ── Optional: App Insights (populated from deployment outputs) ───────────────
# APPLICATIONINSIGHTS_CONNECTION_STRING=<connection-string>
